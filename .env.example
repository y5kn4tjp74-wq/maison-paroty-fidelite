# Google Sheet used for live stats on the landing page & dashboard.
# The sheet must be shared as "Anyone with the link can view" and contain
# a tab with header row: date | store | scans | signups
# - date: YYYY-MM-DD
# - store: sud | theatre | centre
# - scans, signups: numbers
#
# Sheet ID is the long id in the sheet's URL:
# https://docs.google.com/spreadsheets/d/<SHEET_ID>/edit#gid=<GID>
VITE_GOOGLE_SHEET_ID=
VITE_GOOGLE_SHEET_GID=0
